{
  "name": "university-backend",
  "version": "1.0.0",
  "description": "Multi-tenant university system backend using Express and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node db-init.js",
    "test:audit": "node test-audit-system.js",
    "test:security": "mocha tests/security.test.js --timeout 30000",
    "test": "npm run test:audit && npm run test:security",
    "seed:audit": "node seed-audit-test-data.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "chai-http": "^4.4.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "sinon": "^15.0.1"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "multi-tenant",
    "university"
  ],
  "author": "",
  "license": "ISC"
}
